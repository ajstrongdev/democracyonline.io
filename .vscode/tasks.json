{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Tanstack Start (Unix/macOS)",
      "type": "shell",
      "command": "bun",
      "args": ["run", "dev"],
      "group": "build",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Start Database (Bash)",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/src/scripts/postgres.sh"],
      "group": "build",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Start Dev Server (Unix/macOS)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Start Tanstack Start (Unix/macOS)",
        "Start Database (Bash)"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Oscana: production clone + isolated app + scheduler",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/local/full-stack.mjs"],
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
