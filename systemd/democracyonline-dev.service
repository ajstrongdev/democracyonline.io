[Unit]
Description=Democracy Online (development)
After=network-online.target docker.service postgresql.service
Requires=docker.service postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=deploy
WorkingDirectory=/srv/democracyonline-dev
ExecStart=/usr/bin/docker compose --env-file /srv/democracyonline-dev/.env up -d --no-recreate
ExecStop=/usr/bin/docker compose --env-file /srv/democracyonline-dev/.env down

[Install]
WantedBy=multi-user.target
