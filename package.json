{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "deploy": "docker compose --env-file .env up -d --build",
    "deploy:restart": "docker compose --env-file .env up -d --build --force-recreate",
    "deploy:down": "docker compose --env-file .env down",
    "deploy:logs": "docker compose --env-file .env logs -f --tail=200",
    "deploy:prod": "DEPLOYED_ENV=production docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "deploy:dev": "DEPLOYED_ENV=development docker compose --env-file .env -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "deploy:target": "node scripts/deploy-target.mjs",
    "down:prod": "DEPLOYED_ENV=production docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml down",
    "down:dev": "DEPLOYED_ENV=development docker compose --env-file .env -f docker-compose.yml -f docker-compose.dev.yml down",
    "down:target": "node scripts/deploy-target.mjs down",
    "logs:prod": "DEPLOYED_ENV=production docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml logs -f --tail=200",
    "logs:dev": "DEPLOYED_ENV=development docker compose --env-file .env -f docker-compose.yml -f docker-compose.dev.yml logs -f --tail=200",
    "seed:fresh": "node --env-file=.env --import tsx scripts/seed-fresh.ts",
    "seed:fresh:prod": "DEPLOYED_ENV=production node --env-file=.env --import tsx scripts/seed-fresh.ts",
    "seed:fresh:dev": "DEPLOYED_ENV=development node --env-file=.env --import tsx scripts/seed-fresh.ts",
    "seed:fresh:target": "node scripts/seed-target.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "pnpm db:seed:elections",
    "db:seed:elections": "tsx scripts/seed.ts elections",
    "db:seed:elections-finished": "tsx scripts/seed.ts elections-finished",
    "db:seed:candidate-signup": "tsx scripts/seed.ts candidate-signup",
    "db:seed:primary-winner": "tsx scripts/seed.ts primary-winner",
    "db:seed:midterms": "tsx scripts/seed.ts midterms",
    "db:seed:committee-test": "tsx scripts/seed.ts committee-test",
    "db:seed:fresh": "tsx scripts/seed-fresh.ts",
    "nation:randomize": "tsx scripts/randomize-nation.ts",
    "election:dry-run": "tsx scripts/election-dry-run.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ajstrongdev/start-themes": "^1.0.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@opentelemetry/instrumentation-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.24",
    "@tanstack/router-plugin": "^1.168.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.39.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.25.0",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@latest",
    "pg": "^8.11.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.2",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}